<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1B2A"
    android:padding="16dp"
    tools:context=".MainActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/topImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/elder_care" />

        <Button
            android:id="@+id/signOutButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign Out"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:backgroundTint="@android:color/holo_green_dark"
            android:textColor="#FFFFFF"/>
    </FrameLayout>



    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Medicine Reminder App"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/sosButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#FDB021"
            android:text="SOS Button"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/setReminderButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Set Reminder"
            android:background="#FDB021"
            android:textColor="#FFFFFF"
            android:layout_marginStart="8dp" />
    </LinearLayout>


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Medicine"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:layout_marginTop="16dp" />


    <EditText
        android:id="@+id/medicineName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Medicine name:"
        android:background="@android:color/white"
        android:layout_marginTop="8dp"
        android:padding="12dp" />

    <!-- Reason -->
    <EditText
        android:id="@+id/reasonField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Reason:"
        android:background="@android:color/white"
        android:layout_marginTop="8dp"
        android:padding="12dp" />




    <Button
        android:id="@+id/nextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Next"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:backgroundTint="@android:color/holo_green_light" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/navMedicine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Medicine" />

        <Button
            android:id="@+id/navTimings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Timings"
            android:layout_marginStart="8dp" />

        <Button
            android:id="@+id/navDays"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Days" />

        <ImageView
            android:id="@+id/navHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:src="@drawable/home" />
    </LinearLayout>

</LinearLayout>
